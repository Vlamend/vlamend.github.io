---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const topics = [
  { title: 'Basi della programmazione', text: 'Algoritmi, variabili, condizioni, cicli e funzioni.' },
  { title: 'C e C++', text: 'Puntatori, array, struct e ricorsione.' },
  { title: 'Java a oggetti', text: 'Classi, ereditarietà, eccezioni e collezioni.' },
  { title: 'Python da zero', text: 'Script semplici, liste, dizionari e file.' },
  { title: 'HTML, CSS e JavaScript', text: 'Dalla pagina statica alle prime interazioni.' },
];
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Ciao, vorrei informazioni sulle ripetizioni di informatica.')}`;
---
<Base
  title="Ripetizioni di informatica per le superiori"
  description="Ripetizioni di programmazione e basi dell’informatica per studenti delle superiori: C, C++, Java, Python, HTML, CSS e JavaScript."
>
  <main>
    <header class="top">
      <span class="brand">{site.name}</span>
      <div class="top-right">
        <button type="button" id="tema" class="switch" role="switch" aria-checked="false" aria-label="Tema scuro">
          <span class="knob">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" fill="currentColor" />
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </span>
        </button>
      </div>
    </header>

    <section class="hero">
      <div>
        <h1>Informatica alle superiori, un passo alla volta.</h1>
        <p class="lead">
          Ripetizioni di programmazione e basi dell’informatica. Si parte da dove sei
          bloccato, non da dove dice il libro.
        </p>
        <p class="actions">
          <a class="btn" href={wa}>Scrivimi su WhatsApp</a>
        </p>
      </div>
      <pre class="note" aria-label="CodeCiao" id="codeCiao">
        <code>
  def saluta(nome):
    return "Ciao, " + nome
  print(saluta("mondo"))</code>
      </pre>
      <script is:inline>
  var esempi = [
`def saluta(nome):
    return "Ciao, " + nome

print(saluta("mondo"))`,
`function saluta(nome) {
  return "Ciao, " + nome;
}

console.log(saluta("mondo"));`,
`#include <stdio.h>

void saluta(char *nome) {
  printf("Ciao, %s\\n", nome);
}`,
`#include <iostream>
using namespace std;

void saluta(string nome) {
  cout << "Ciao, " << nome << endl;
}`,
`static String saluta(String nome) {
  return "Ciao, " + nome;
}`
  ];
  var el = document.getElementById('codeCiao');
  console.log(el);
  if (el) el.textContent = esempi[Math.floor(Math.random() * esempi.length)];
</script>
    </section>

    <section id="argomenti">
      <h2>Argomenti trattati</h2>
      <ul class="topics">
        {topics.map((t) => (
          <li>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Come lavoriamo</h2>
      <p class="narrow">
        Porti l’esercizio che non esce o la verifica che si avvicina. Lo risolviamo insieme,
        scrivendo il codice tu e spiegando io. Alla fine hai un esercizio simile da rifare da solo.
      </p>
      <p class="narrow"><strong>Modalità:</strong> {site.mode}. <strong>Costo:</strong> {site.price}.</p>
    </section>

    <section>
      <h2>Chi sono</h2>
      <p class="narrow">
        Sono {site.name}, studente di Informatica all’Università di Bologna e sviluppatore
        backend freelance (Node.js, MongoDB). Lavoro con il codice ogni giorno e so dove
        di solito ci si blocca.
      </p>
    </section>

    <section id="contatti" class="contact">
      <h2>Contatti</h2>
      <p class="narrow">Scrivimi dicendomi la classe e l’argomento: ti rispondo con una proposta di orari.</p>
      <p class="actions">
        <a class="btn" href={wa}>WhatsApp</a>
        <a class="btn" href={`mailto:${site.email}`}>Gmail</a>
      </p>
    </section>

    <footer>© {new Date().getFullYear()} {site.name}</footer>
  </main>
</Base>

<style>
  main {
    position: relative;
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.25rem 0 2rem;
  }
  main::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 0.75rem;
    width: 2px;
    background: color-mix(in srgb, var(--margin) 55%, transparent);
  }
  .top { display: flex; justify-content: space-between; align-items: baseline; padding: 1.5rem 0; }
  .brand { font-family: var(--display); font-weight: 700; }
  .top-right { display: flex; gap: 1.25rem; align-items: center; }
  .switch {
  position: relative; width: 3.25rem; height: 1.75rem; padding: 0;
  border: 1.5px solid var(--ink); border-radius: 999px;
  background: var(--card); cursor: pointer;
}
.knob {
  position: absolute; top: 2px; left: 2px; width: 1.3rem; height: 1.3rem;
  border: 1.5px solid var(--ink); border-radius: 50%; background: var(--paper); color: var(--ink);
  display: grid; place-items: center; transition: transform 0.2s;
}
.switch[aria-checked='true'] .knob { transform: translateX(1.5rem); }
.knob svg { width: 0.85rem; height: 0.85rem; }
.moon { display: none; }
.switch[aria-checked='true'] .sun { display: none; }
.switch[aria-checked='true'] .moon { display: block; }
@media (prefers-reduced-motion: reduce) { .knob { transition: none; } }
  section { padding: 3rem 0; }
  h2 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); margin-bottom: 1.25rem; }
  .hero { display: grid; gap: 2.5rem; padding-top: 2rem; align-items: center; }
  @media (min-width: 52rem) { .hero { grid-template-columns: 1.3fr 1fr; } }
  h1 { font-size: clamp(2.5rem, 6.5vw, 4.5rem); font-weight: 800; }
  .lead { font-size: 1.25rem; max-width: 34rem; margin: 1.25rem 0 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; margin: 0; }
  .btn {
    background: linear-gradient(135deg, var(--btn-bg), color-mix(in srgb, var(--btn-bg) 30%, var(--margin)));
    color: var(--btn-text); text-decoration: none;
    padding: 0.75rem 1.25rem; border-radius: 6px;
  }
  .btn:hover { background: linear-gradient(135deg, var(--btn-hover), color-mix(in srgb, var(--btn-hover) 60%, var(--margin))); }
  .note {
    margin: 0; padding: 1.5rem; background: var(--card); color: var(--code);
    border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--grid);
    transform: rotate(-1.5deg); font: 1rem/1.7 ui-monospace, Menlo, Consolas, monospace;
    overflow-x: auto;
  }
  .topics { list-style: none; margin: 0; padding: 0; max-width: 44rem; }
  .topics li { border-top: 2px solid var(--ink); padding: 1rem 0; background: color-mix(in srgb, var(--paper) 88%, transparent); }
  .topics li:last-child { border-bottom: 2px solid var(--ink); }
  .topics h3 { font-size: 1.35rem; }
  .topics p { margin: 0.25rem 0 0; }
  .narrow { max-width: 38rem; margin: 0 0 1rem; }
  footer { padding: 2rem 0 3rem; font-size: 0.9rem; }
</style>

<script>
  const btn = document.getElementById('tema');
  const root = document.documentElement;
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches);
  const label = () => {
  btn?.setAttribute('aria-checked', String(isDark()));
};
  label();
  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('tema', next); } catch (e) {}
    label();
  });
  mq.addEventListener('change', label);
</script>